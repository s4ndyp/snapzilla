<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snapzilla</AssemblyName>
    <RootNamespace>Snapzilla.Client</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Snapzilla</Company>
    <Product>Snapzilla Capture Client</Product>
    <Description>Upload screenshots to your Snapzilla server</Description>
  </PropertyGroup>
</Project>
