# Poort op de SERVER waar de web-UI bereikbaar is (host → container :80).
# Standaard 3000. Site op poort 80? Zet SNAPZILLA_PORT=80 — client-URL: http://<server-ip> (zonder :3000).
SNAPZILLA_PORT=3000

# Tekst uit screenshots (OpenRouter vision — geen lokale OCR-container meer)
# Maak op de server /opt/snapzilla/.env aan (niet committen) met je key:
OPENROUTER_API_KEY=
# Optioneel: ander vision-model op https://openrouter.ai/models
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
