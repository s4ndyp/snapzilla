# Poort op de SERVER waar de web-UI bereikbaar is (host → container :80).
# Standaard 3000. Site op poort 80? Zet SNAPZILLA_PORT=80 — client-URL: http://<server-ip> (zonder :3000).
SNAPZILLA_PORT=3000

# OCR (optioneel — standaard aan via docker-compose service "ocr")
# Laat OCR_SERVICE_URL leeg in de analyzer om OCR over te slaan.
# OCR_ENGINE=tesseract
# OCR_LANG=nld+eng
